diff --git a/src/engine/core/MarioRender.java b/src/engine/core/MarioRender.java
index aa278681..93f5a44f 100755
--- a/src/engine/core/MarioRender.java
+++ b/src/engine/core/MarioRender.java
@@ -5,0 +6 @@
+import engine.helper.GameStatus;
@@ -64,0 +66,27 @@
+    public void renderGameStatus(GameStatus status, Graphics g) {
+        String message;
+        switch (status) {
+            case WIN:
+                message = "GANASTE";
+                break;
+            case TIME_OUT:
+                message = "TIEMPO AGOTADO";
+                break;
+            case LOSE:
+                message = "PERDISTE";
+                break;
+            default:
+                return;
+        }
+
+        int width = (int) (256 * scale);
+        int height = (int) (240 * scale);
+        g.setColor(new Color(0, 0, 0, 190));
+        g.fillRect(0, 0, width, height);
+        g.setColor(Color.WHITE);
+        g.setFont(new Font(Font.SANS_SERIF, Font.BOLD, (int) (24 * scale)));
+        FontMetrics metrics = g.getFontMetrics();
+        int x = (width - metrics.stringWidth(message)) / 2;
+        int y = (height + metrics.getAscent()) / 2;
+        g.drawString(message, x, y);
+    }
